{
  "manifest_version": 3,
  "name": "İndiren · Video Bulucu",
  "version": "0.3.0",
  "description": "Geçerli sekmedeki doğrudan video bağlantılarını bulur ve indirir.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Videoları bul"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detector.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
